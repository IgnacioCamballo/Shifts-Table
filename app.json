{
  "expo": {
    "name": "shifts-table",
    "slug": "shifts-table",
    "owner": "ignaciocamballo",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shiftstable",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/st-icono.png",
        "backgroundImage": "./assets/fondo-icono.png"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.shiftstable"
    },
    "scheme": "shifts-table",
    "extra": {
      "eas": {
        "projectId": "968dc7b3-ab52-4e39-a056-846429f84d9d"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-dev-launcher",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4926030013898312~7320718360",
          "iosAppId": "ca-app-pub-4926030013898312~8140812186"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ]
    ]
  }
}
