{
  "expo": {
    "name": "shifts-table",
    "slug": "shifts-table",
    "owner": "ignaciocamballo",
    "version": "3.1.1",
    "orientation": "portrait",
    "icon": "./assets/icono.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kanatzu.shiftstable",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/icono.png",
      "infoPlist": {
        "NSCameraUsageDescription": "La cámara se utiliza a través de la dependencia de Stripe para funciones de escaneo de tarjetas; no es una función propia de la aplicación.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/st-icono.png",
        "backgroundImage": "./assets/fondo-icono.png"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.shiftstable"
    },
    "scheme": "shifts-table",
    "extra": {
      "eas": {
        "projectId": "968dc7b3-ab52-4e39-a056-846429f84d9d"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-dev-launcher",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4926030013898312~9221423165",
          "iosAppId": "ca-app-pub-4926030013898312~8828441423"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.shiftstable",
          "enableGooglePay": true
        }
      ]
    ]
  }
}
